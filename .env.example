# Copy to .env at the repo root. Both apps and packages/db read it.

# Infrastructure (docker compose up -d)
DATABASE_URL="postgresql://qira:qira@localhost:5433/qira?schema=public"
REDIS_URL="redis://localhost:6379"

# Public base URL encoded inside every QR: {BASE_URL}/q/{slug}
# In dev, Next.js (port 3000) proxies /q/* to the API, so one origin serves everything.
BASE_URL="http://localhost:3000"

# Internal API origin (used by Next.js server side and rewrites)
API_URL="http://localhost:4000"
API_PORT=4000

# Comma-separated list of "apiKey:userId" pairs accepted by /api/v1/*
API_KEYS="dev-key-change-me:demo-user"
# Key the web dashboard uses server-side to talk to the API
WEB_API_KEY="dev-key-change-me"

# Secret used to sign PIN unlock cookies and daily visitor hashes
COOKIE_SECRET="change-me-to-a-long-random-string"

# Asset storage: "local" (apps/api/uploads) or "s3" (R2 / AWS S3)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
